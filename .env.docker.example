# Copie este arquivo e preencha com seus valores reais.
# Frontend/Admin: salve como .env.local
# API: salve como kit-personagens-api/.env

# --- Supabase (obrigatório mesmo com PostgreSQL local — usado para Auth e Storage) ---
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- URLs dos serviços ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- PostgreSQL local (opcional: DATABASE_URL apontando para o container) ---
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/kit_personagens

# --- Admin: Vercel Blob (upload de assets) ---
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
